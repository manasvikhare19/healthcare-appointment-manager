# ==========================================
# Healthcare Appointment & Follow-up Manager
# Backend Environment Configuration
# ==========================================

# Server Port & URLs
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database URL
# For local development (SQLite - zero config required):
DATABASE_URL="file:./dev.db"
# For production (PostgreSQL - e.g. Neon, Supabase, Render):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication
JWT_SECRET=super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_DAYS=7

# Slot Reservation Hold Duration (minutes)
SLOT_HOLD_MINUTES=5

# ==========================================
# EMAIL NOTIFICATIONS (Gmail / SMTP / Resend)
# ==========================================
# EMAIL_PROVIDER options: 'gmail' | 'smtp' | 'resend'
# If unconfigured, emails are safely logged to the console and recorded in the database.

# --- Option 1: Gmail (Recommended for testing / quick setup) ---
# To use Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#    (Select App: 'Mail', Device: 'Other')
# 3. Paste the 16-character App Password below (spaces will be automatically trimmed).
EMAIL_PROVIDER=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Option 2: Generic SMTP (SendGrid, Mailgun, AWS SES, custom SMTP) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM="Meridian Clinic <no-reply@clinic.local>"

# --- Option 3: Resend (Works on hosts blocking SMTP ports, e.g. Render free tier) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# SMTP_FROM="Meridian Clinic <onboarding@resend.dev>"

EMAIL_ENABLED=true
SMTP_FROM="Meridian Clinic <no-reply@clinic.local>"

# Optional: Redirect ALL outgoing notification emails (for both doctor & patient)
# to your personal email address during testing, so you can see all emails flow smoothly:
# EMAIL_OVERRIDE=your-personal-email@gmail.com

# ==========================================
# GOOGLE CALENDAR API (OAuth 2.0)
# ==========================================
# To enable Google Calendar Sync:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a project and enable the "Google Calendar API"
# 3. Under "APIs & Services" > "Credentials", create "OAuth 2.0 Client IDs"
#    Application type: Web application
#    Authorized redirect URIs: http://localhost:4000/api/calendar/oauth/callback
# 4. Copy the Client ID and Client Secret below and set CALENDAR_ENABLED=true
CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# ==========================================
# AI / LLM INTEGRATION
# ==========================================
# LLM_PROVIDER options: 'gemini' | 'anthropic' | 'openai' | 'none'
# If set to 'none' or keys missing, a deterministic, rule-based clinical fallback is used.

# --- Option 1: Google Gemini (Free tier available, no credit card required) ---
# Get a free API key at: https://aistudio.google.com/apikey
LLM_PROVIDER=none
GEMINI_API_KEY=your_gemini_api_key_here

# --- Option 2: Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- Option 3: OpenAI ---
# OPENAI_API_KEY=sk-proj-your-key-here
